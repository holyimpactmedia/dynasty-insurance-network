# Temporary provider switch. Defaults to supabase when omitted.
PLATFORM_PROVIDER=supabase

# Supabase - retained during the seven-day rollback window
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DIRECT_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres

# Neon - pooled runtime URL + direct migration/import URL
DATABASE_URL=postgresql://app:password@endpoint-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_DIRECT=postgresql://owner:password@endpoint.region.aws.neon.tech/neondb?sslmode=require

# Better Auth - active only when PLATFORM_PROVIDER=neon
BETTER_AUTH_URL=https://yourdomain.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes

# One-time bootstrap only. Never leave AUTH_BOOTSTRAP_MODE enabled in production.
AUTH_BOOTSTRAP_MODE=false
AUTH_BOOTSTRAP_USERS_FILE=/absolute/path/outside-repo/bootstrap-users.json

# Site URL - used for redirects and absolute URLs (e.g. https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Resend - used for transactional email (lead confirmation + admin notifications)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Admin email - receives a rich notification on every new lead (all data + AI score + USHA status)
ADMIN_EMAIL=you@yourdomain.com

# CAN-SPAM compliance - shown in the consumer confirmation email footer
UNSUBSCRIBE_EMAIL=unsubscribe@yourdomain.com
HOLY_IMPACT_MAILING_ADDRESS=Your Company, LLC, 123 Main St, City, ST 00000

# USHA Marketplace / LeadArena - where leads are posted for agents to purchase.
# USHA_ENABLED must be 'true' AND both credentials present for posting to occur;
# otherwise leads are marked usha_status='pending'.
# Contact support@leadarena.com to obtain credentials and the API spec.
USHA_ENABLED=false
USHA_API_URL=https://app.ushamarketplace.com/api/v1/leads
USHA_API_KEY=your-usha-api-key

# Anthropic - used for AI lead scoring (0-100 score + urgency + recommended approach)
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# TrustedForm - used to claim TCPA compliance certificates on lead submission
TRUSTEDFORM_API_KEY=your-trustedform-api-key
